<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Conductor.AspNetCore</PackageId>
    <Title>Conductor .NET ASP.NET Core Integration</Title>
    <Description>ASP.NET Core integration for Conductor.NET that maps request validation failures to ProblemDetails.</Description>
    <RootNamespace>Conductor.AspNetCore</RootNamespace>
    <AssemblyName>Conductor.AspNetCore</AssemblyName>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Sergio Valadão Junior</Authors>
    <Company>SVCODE</Company>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Conductor.Abstractions\Conductor.Abstractions.csproj" />
  </ItemGroup>
</Project>
