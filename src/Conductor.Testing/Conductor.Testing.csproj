<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Conductor.Testing</PackageId>
    <Title>Conductor .NET Testing</Title>
    <Description>Test helpers for Conductor.NET: fake dispatchers, a fake notification publisher, recording pipeline behaviors, and scoped test hosts.</Description>
    <RootNamespace>Conductor.Testing</RootNamespace>
    <AssemblyName>Conductor.Testing</AssemblyName>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Sergio Valadão Junior</Authors>
    <Company>SVCODE</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Conductor.Abstractions\Conductor.Abstractions.csproj" />
    <ProjectReference Include="..\Conductor.DependencyInjection\Conductor.DependencyInjection.csproj" />
  </ItemGroup>
</Project>
