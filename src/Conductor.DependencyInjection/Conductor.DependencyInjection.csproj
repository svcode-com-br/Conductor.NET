<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ConductorNET.DependencyInjection</PackageId>
    <Title>Conductor .NET DependencyInjection</Title>
    <Description>Microsoft.Extensions.DependencyInjection integration for Conductor.NET, including AddConductor, assembly scanning, and duplicate-handler detection.</Description>
    <RootNamespace>Conductor.DependencyInjection</RootNamespace>
    <AssemblyName>Conductor.DependencyInjection</AssemblyName>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Sergio Valadão Junior</Authors>
    <Company>SVCODE</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\Conductor\Conductor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conductor.DependencyInjection.Tests" />
    <InternalsVisibleTo Include="Conductor.IntegrationTests" />
    <InternalsVisibleTo Include="Conductor.ArchitectureTests" />
  </ItemGroup>
</Project>
