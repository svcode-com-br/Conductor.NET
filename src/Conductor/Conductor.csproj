<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Conductor</PackageId>
    <Title>Conductor .NET</Title>
    <Description>Lightweight CQRS and mediator runtime for .NET: dispatchers, pipeline execution, validation behavior, and diagnostics.</Description>
    <RootNamespace>Conductor</RootNamespace>
    <AssemblyName>Conductor</AssemblyName>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Sergio Valadão Junior</Authors>
    <Company>SVCODE</Company>
    <RepositoryUrl>https://github.com/svcode-com-br/Conductor.NET</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\Conductor.Abstractions\Conductor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conductor.DependencyInjection" />
    <InternalsVisibleTo Include="Conductor.Tests" />
    <InternalsVisibleTo Include="Conductor.DependencyInjection.Tests" />
    <InternalsVisibleTo Include="Conductor.IntegrationTests" />
    <InternalsVisibleTo Include="Conductor.ArchitectureTests" />
    <InternalsVisibleTo Include="Conductor.Benchmarks" />
  </ItemGroup>
</Project>
